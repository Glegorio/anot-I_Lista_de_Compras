  "fixed_sql": [
    {
      "name": "local_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"local_categories\" (\"slug\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"icon_key\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, PRIMARY KEY (\"slug\"));"
        }
      ]
    },
    {
      "name": "shopping_lists",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_lists\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"budget\" TEXT NULL, \"shopping_state\" TEXT NOT NULL DEFAULT 'planning', \"started_at\" INTEGER NULL, \"finished_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "shopping_list_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"shopping_list_items\" (\"id\" TEXT NOT NULL, \"list_id\" TEXT NOT NULL REFERENCES shopping_lists (id) ON DELETE CASCADE, \"name\" TEXT NOT NULL, \"quantity\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"category_slug\" TEXT NULL REFERENCES local_categories (slug) ON DELETE SET NULL, \"checked\" INTEGER NOT NULL DEFAULT 0 CHECK (\"checked\" IN (0, 1)), \"position\" INTEGER NOT NULL, \"not_found\" INTEGER NOT NULL DEFAULT 0 CHECK (\"not_found\" IN (0, 1)), \"substitute_name\" TEXT NULL, \"found_price\" TEXT NULL, \"unit_price\" TEXT NULL, \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (CAST(quantity AS REAL) > 0), CHECK (unit_price IS NULL OR CAST(unit_price AS REAL) >= 0));"
        }
      ]
    },
    {
      "name": "price_snapshots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"price_snapshots\" (\"id\" TEXT NOT NULL, \"item_id\" TEXT NOT NULL REFERENCES shopping_list_items (id) ON DELETE CASCADE, \"amount\" TEXT NOT NULL, \"currency\" TEXT NOT NULL DEFAULT 'BRL', \"unit\" TEXT NOT NULL, \"kind\" TEXT NOT NULL DEFAULT 'predicted', \"captured_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"preferences\" (\"key\" TEXT NOT NULL, \"value\" TEXT NOT NULL, PRIMARY KEY (\"key\"));"
        }
      ]
    }
  ]
